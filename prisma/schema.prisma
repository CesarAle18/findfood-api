/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model asignacion {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  donacion_id       String             @unique(map: "uq_asignacion_vigente", where: raw("(estado = ANY (ARRAY['OFRECIDA'::estado_asignacion, 'ACEPTADA'::estado_asignacion]))")) @db.Uuid
  voluntario_id     String?            @db.Uuid
  banco_ejecutor_id String?            @db.Uuid
  ruta_id           String?            @db.Uuid
  intento           Int                @default(1) @db.SmallInt
  estado            estado_asignacion  @default(OFRECIDA)
  score             Decimal?           @db.Decimal(6, 3)
  distancia_km      Decimal?           @db.Decimal(7, 2)
  ofrecida_at       DateTime           @default(now()) @db.Timestamptz(6)
  expira_at         DateTime           @db.Timestamptz(6)
  respondida_at     DateTime?          @db.Timestamptz(6)
  aceptada_at       DateTime?          @db.Timestamptz(6)
  finalizada_at     DateTime?          @db.Timestamptz(6)
  abandonada_at     DateTime?          @db.Timestamptz(6)
  motivo_id         Int?               @db.SmallInt
  observacion       String?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  banco_alimentos   banco_alimentos?   @relation(fields: [banco_ejecutor_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_asignacion_banco")
  donacion          donacion           @relation(fields: [donacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_asignacion_donacion")
  motivo            motivo?            @relation(fields: [motivo_id], references: [id], onUpdate: NoAction, map: "fk_asignacion_motivo")
  ruta              ruta?              @relation(fields: [ruta_id], references: [id], onUpdate: NoAction, map: "fk_asignacion_ruta")
  voluntario        voluntario?        @relation(fields: [voluntario_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_asignacion_voluntario")
  calificacion      calificacion[]
  historial_estado  historial_estado[]
  incidencia        incidencia[]
  notificacion      notificacion[]

  @@unique([donacion_id, intento], map: "uq_asignacion_intento")
  @@index([expira_at], map: "ix_asignacion_expira", where: raw("(estado = 'OFRECIDA'::estado_asignacion)"))
  @@index([voluntario_id, estado, ofrecida_at(sort: Desc)], map: "ix_asignacion_voluntario")
  @@schema("public")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
