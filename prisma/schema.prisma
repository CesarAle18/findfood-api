generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "public"]
}

model users {
  instance_id            String?      @db.Uuid
  id                     String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aud                    String?      @db.VarChar(255)
  role                   String?      @db.VarChar(255)
  email                  String?      @db.VarChar(255)
  encrypted_password     String?      @db.VarChar(255)
  email_confirmed_at     DateTime?    @db.Timestamptz(6)
  confirmation_token     String?      @db.VarChar(255)
  recovery_token         String?      @db.VarChar(255)
  email_change           String?      @db.VarChar(255)
  email_change_token_new String?      @db.VarChar(255)
  raw_app_meta_data      Json?
  raw_user_meta_data     Json?
  banned_until           DateTime?    @db.Timestamptz(6)
  created_at             DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?    @default(now()) @db.Timestamptz(6)
  identities             identities[]
  usuario                usuario?

  @@schema("auth")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model alerta_inventario {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  banco_id         String           @db.Uuid
  lote_id          String?          @db.Uuid
  tipo             String           @db.VarChar(30)
  nivel            severidad        @default(MEDIA)
  dias_para_vencer Int?             @db.SmallInt
  mensaje          String
  generada_at      DateTime         @default(now()) @db.Timestamptz(6)
  atendida_at      DateTime?        @db.Timestamptz(6)
  atendida_por     String?          @db.Uuid
  accion_tomada    String?
  banco_alimentos  banco_alimentos  @relation(fields: [banco_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_alerta_banco")
  lote_inventario  lote_inventario? @relation(fields: [lote_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_alerta_lote")
  usuario          usuario?         @relation(fields: [atendida_por], references: [id], onUpdate: NoAction, map: "fk_alerta_usuario")

  @@unique([lote_id, tipo], map: "uq_alerta_abierta", where: raw("((atendida_at IS NULL) AND (lote_id IS NOT NULL))"))
  @@index([banco_id, generada_at(sort: Desc)], map: "ix_alerta_banco", where: raw("(atendida_at IS NULL)"))
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model almacen {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  banco_id           String                   @db.Uuid
  nombre             String                   @db.VarChar(80)
  direccion          String                   @db.VarChar(255)
  ubicacion          Unsupported("geography")
  tipo               tipo_almacenamiento
  capacidad_kg       Decimal                  @db.Decimal(12, 2)
  activo             Boolean                  @default(true)
  created_at         DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at         DateTime                 @default(now()) @db.Timestamptz(6)
  banco_alimentos    banco_alimentos          @relation(fields: [banco_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_almacen_banco")
  donacion           donacion[]
  lote_inventario    lote_inventario[]
  parada_ruta        parada_ruta[]
  recepcion_donacion recepcion_donacion[]
  ruta               ruta[]

  @@unique([banco_id, nombre], map: "uq_almacen_banco_nombre")
  @@index([ubicacion], map: "ix_almacen_ubicacion", type: Gist)
  @@schema("public")
}

