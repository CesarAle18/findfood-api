# Copiar a .env para desarrollo local. En Railway, estas variables se definen
# en el servicio. La API valida todas al arrancar (src/config/configuracion.ts).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Rol app_backend por Supavisor en modo sesión (docs/arquitectura.md §12.2).
# Local (scripts/db-local.sh subir):
DATABASE_URL=postgresql://app_backend:app_backend_local@127.0.0.1:54329/findfood
DB_POOL_MAX=10

# Solo para `npm run db:pull` (introspección como postgres; nunca la usa la API).
PRISMA_INTROSPECCION_URL=postgresql://postgres:postgres@127.0.0.1:54329/findfood

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>
# Solo si el proyecto firma los JWT con el secreto HS256 heredado:
# SUPABASE_JWT_SECRET=

# Obligatoria en producción. Sin ella se usa la distancia geodésica (§6.3).
# GOOGLE_MAPS_API_KEY=
# EXPO_ACCESS_TOKEN=

# Correo con la contraseña temporal de los asesores (§19.5).
# SMTP_URL=smtp://usuario:clave@smtp.ejemplo.com:587
# SMTP_FROM="FindFood <no-responder@ejemplo.com>"

# DOCS_HABILITADOS=true
# TAREAS_HABILITADAS=true
# CORS_ORIGENES=http://localhost:5173
